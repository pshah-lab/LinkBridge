<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>LinkBridge finds nearby devices on this Wi-Fi network and transfers files directly between them.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Pairing uses plain HTTP to the Mac's local port, protected by the six-digit code. -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSBonjourServices</key>
    <array>
        <string>_linkbridge._tcp</string>
    </array>
</dict>
</plist>
