<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>LinkBridge finds nearby devices on this Wi-Fi network, sends files to them and receives files from them directly.</string>
    <key>NSCameraUsageDescription</key>
    <string>Scan the code on your Android device to connect without Wi-Fi.</string>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Pairing uses plain HTTP to the Mac's local port, protected by the six-digit code. -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSBonjourServices</key>
    <array>
        <string>_linkbridge._tcp</string>
    </array>
</dict>
</plist>
