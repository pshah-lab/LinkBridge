<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep LinkBridge's identity, pairing keys and paired devices out of cloud backup and
  device-to-device transfer. The secrets are encrypted with Android Keystore keys that
  never leave this device, so a copy would be useless; re-pair on the new phone instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
